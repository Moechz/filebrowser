# ===========================================================================
# Multilingual file for the TOS 7 Docker application "filebrowserdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "File Browser"
auth         = "File Browser"
version      = "@@VERSION@@"
descript     = "File Browser is a self-hosted web file manager. Browse, upload, download, rename, move, delete, preview and edit text files from any browser; create share links; manage users with per-folder permissions; search your files. This package runs the official Docker Hub image as a non-root container, with data under /Volume1/DockerAppData/filebrowserdocker/."
release_note = "2.32.0-2 - rectified the 2.32.0-1 listing review. C3: privacy policy added (PRIVACY.md, reachable from the package help link). C9: descriptions corrected to the delivered feature set (the Chinese variants carried an unrelated app description; the English text no longer overstates features). C10: README completed and repository layout documented. F2: the container entrypoint is pinned to /filebrowser, so the service starts on x86_64 and aarch64 (2.32.0-1 exec'd '-p'). F22: webui.bz2 front-end bundle added. F11: uninstall data retention documented. T1: upstream image CVE position documented in the CHANGELOG; moving to the latest upstream image needs a separate packaging migration."
important    = "Open the web UI on port 8128; the first-run login is admin/admin - change it immediately in Settings. Data (your files and filebrowser.db) lives in /Volume1/DockerAppData/filebrowserdocker/data/ and survives restarts and updates. The container runs as uid 1000. Needs DockerEngine; configure a registry mirror if Docker Hub is unreachable. Uninstalling keeps that data directory (platform policy) - delete it yourself to remove all files and accounts. Plain HTTP on the LAN."

[zh-cn]
name         = "File Browser"
auth         = "File Browser"
version      = "@@VERSION@@"
descript     = "File Browser 是一款自托管的网页文件管理器：在浏览器里浏览、上传、下载、重命名、移动、删除、预览和编辑文本文件，可创建分享链接、管理多用户与目录权限、搜索文件。本包以非 root 容器运行官方 Docker Hub 镜像，数据保存在 /Volume1/DockerAppData/filebrowserdocker/。"
release_note = "2.32.0-2：针对 2.32.0-1 审核意见的整改。C3：新增隐私政策（PRIVACY.md，帮助链接指向该文件）。C9：描述改为与实际功能一致（原中文描述写的是另一个应用）。C10：补全 README 与仓库目录说明。F2：容器启动命令固定使用 /filebrowser，x86_64 与 aarch64 均可启动。F22：补充 webui.bz2 前端包。F11：说明卸载后数据目录的保留策略。T1：上游镜像 CVE 情况已在 CHANGELOG 说明，升级到最新上游镜像需单独的打包迁移。"
important    = "网页入口为 8128 端口，首次登录账号密码为 admin/admin，请立即在设置中修改。数据（文件与 filebrowser.db）保存在 /Volume1/DockerAppData/filebrowserdocker/data/，重启和升级不会丢失。容器以 uid 1000 运行。需要 DockerEngine；Docker Hub 不可达时先配置镜像加速。卸载后该数据目录按平台策略保留，如需彻底删除请自行删除。局域网内为 HTTP。"

[zh-hk]
name         = "File Browser"
auth         = "File Browser"
version      = "@@VERSION@@"
descript     = "File Browser 是一款自託管的網頁檔案管理器：在瀏覽器裡瀏覽、上傳、下載、重新命名、移動、刪除、預覽和編輯文字檔案，可建立分享連結、管理多使用者與目錄權限、搜尋檔案。本包以非 root 容器執行官方 Docker Hub 映像，資料保存在 /Volume1/DockerAppData/filebrowserdocker/。"
release_note = "2.32.0-2：針對 2.32.0-1 審核意見的整改。C3：新增隱私政策（PRIVACY.md，說明連結指向該檔案）。C9：描述改為與實際功能一致（原中文描述寫的是另一個應用）。C10：補齊 README 與倉庫目錄說明。F2：容器啟動命令固定使用 /filebrowser，x86_64 與 aarch64 均可啟動。F22：補充 webui.bz2 前端包。F11：說明解除安裝後資料目錄的保留原則。T1：上游映像 CVE 情況已在 CHANGELOG 說明，升級到最新上游映像需另外的打包遷移。"
important    = "網頁入口為 8128 埠，首次登入帳號密碼為 admin/admin，請立即在設定中修改。資料（檔案與 filebrowser.db）保存在 /Volume1/DockerAppData/filebrowserdocker/data/，重新啟動和升級不會遺失。容器以 uid 1000 執行。需要 DockerEngine；Docker Hub 不可達時先設定映像加速。解除安裝後該資料目錄依平台原則保留，如需徹底刪除請自行刪除。區域網路內為 HTTP。"

